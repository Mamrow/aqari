{
  "expo": {
    "name": "Aqari",
    "slug": "aqari",
    "scheme": "aqari",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba30e803-8e75-435f-83de-2b953025a60f",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "locales": {
      "en": "./assets/locales/en.json",
      "ar": "./assets/locales/ar.json"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aqari-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0066FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mamrow.aqari",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:lyaqari.netlify.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066FF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.mamrow.aqari",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lyaqari.netlify.app",
              "pathPrefix": "/l/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لعرض العقارات القريبة منك على الخريطة.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج للوصول إلى صورك لإضافة صور العقار.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      "@maplibre/maplibre-react-native",
      [
        "@sentry/react-native",
        {
          "organization": "aqari-l7",
          "project": "react-native"
        }
      ]
    ],
    "owner": "mamrow",
    "extra": {
      "eas": {
        "projectId": "ba30e803-8e75-435f-83de-2b953025a60f"
      }
    }
  }
}
