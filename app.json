{
  "expo": {
    "name": "aqari",
    "slug": "aqari",
    "scheme": "aqari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aqari-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0066FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mamrow.aqari",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066FF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.mamrow.aqari"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لعرض العقارات القريبة منك على الخريطة.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج للوصول إلى صورك لإضافة صور العقار.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      "@maplibre/maplibre-react-native",
      [
        "@sentry/react-native",
        {
          "organization": "aqari-l7",
          "project": "react-native"
        }
      ]
    ],
    "owner": "mamrow",
    "extra": {
      "eas": {
        "projectId": "ba30e803-8e75-435f-83de-2b953025a60f"
      }
    }
  }
}
