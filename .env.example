# From your Supabase project: Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# From maptiler.com account -> Keys (free tier, no card required)
EXPO_PUBLIC_MAPTILER_KEY=

# Optional. Crash reporting is off unless this is set, which is why it's
# blank here — a dev machine chasing a bug can fill it in, but day-to-day
# local work shouldn't be posting crashes to the shared project. Real
# builds get it from EAS (eas env:list), not from this file.
# Sentry -> Settings -> Projects -> react-native -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
