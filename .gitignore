# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# Supabase CLI local cache (project ref, pooler URL, etc — machine-specific,
# not source)
supabase/.temp/

# Claude Code skills installed via `npx skills add` / marketplace plugins —
# local tooling for whoever's working on this repo, not part of the app.
.agents/
.claude/skills/
skills-lock.json

# Playwright CLI's own working directory (snapshots, console logs) — created
# ad hoc while driving a browser for a task, not project output.
.playwright-cli/

# generated native folders
/ios
/android
